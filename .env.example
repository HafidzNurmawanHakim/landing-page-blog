# ===== Cloudflare D1 (dibutuhkan untuk db:migrate / db:studio ke remote) =====
CLOUDFLARE_ACCOUNT_ID=2128e8cb355890222a94bfe0a58b0831
CLOUDFLARE_DATABASE_ID=33eb1e6e-9ab5-4956-a405-6b75b8682c7b
CLOUDFLARE_API_TOKEN=

# ===== Public =====
NEXT_PUBLIC_SITE_URL=https://destitours.com
NEXT_PUBLIC_DEFAULT_LOCALE=id

# ===== Auth Admin =====
# AUTH_SECRET minimal 32 karakter. Di production WAJIB di-set kuat.
AUTH_SECRET=
ADMIN_EMAIL=admin@destitours.com
# Hash PBKDF2 untuk seed admin pertama. Generate dengan: npm run hash-password -- "passwordku"
# Jika kosong saat seed di dev, fallback ke password default "admin123".
ADMIN_PASSWORD_HASH=

# ===== Notifikasi =====
# Kosongkan di local dev -> notifikasi di-log sebagai "skipped" (booking tetap jalan).
# Di production WAJIB di-set: RESEND_API_KEY dan RESEND_FROM_EMAIL.
# RESEND_FROM_EMAIL harus pakai domain yang SUDAH verified di dashboard Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@destitours.com
WHATSAPP_ADMIN_NUMBER=

# ===== Rate limiting =====
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# ===== Gambar Produk (Cloudflare R2) =====
# Kosongkan di local dev -> upload gambar disimpan ke public/uploads.
# Di production WAJIB diisi supaya upload gambar produk tersimpan di R2.
# R2_PUBLIC_URL = URL bucket public (custom domain atau https://<bucket>.<account>.r2.dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
