{
  "name": "shadcn-landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f data/destitour.db* && npm run db:seed",
    "hash-password": "tsx scripts/hash-password.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "preview": "npm run cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:staging": "npm run cf-typegen && cp .env.staging .env && opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "deploy:prod": "npm run cf-typegen && cp .env.prod .env && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
